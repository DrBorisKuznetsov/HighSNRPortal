{
  "name": "portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "build:pages": "npm run build && npm run build:ssr && node scripts/prepare-pages.mjs",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir dist-ssr",
    "check": "npm run lint && npm run build:pages && npm run test:static",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:test": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "test:e2e": "playwright test",
    "test:static": "node scripts/verify-pages.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "wouter": "3.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "vite": "^8.1.0"
  }
}
